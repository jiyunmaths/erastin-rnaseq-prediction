  "elastic_net_fixed": {
    "max_iter": 200000,
    "tol": 1e-11,
    "selection": "cyclic",
    "pure_lasso_start": "Native cold start per candidate and selected refit; nonunique test predictions are not assumed equal across solver starts."
  },
  "primary_features": "Fixed 5/64 gene expression + growth pattern + medium code + basal-medium recipe prefix + recorded FBS percentage and its missingness. No response/lineage/identity/source-vendor fields as model inputs.",
  "condition_fields": "GrowthPattern; observed MF code from OnboardedMedia; recipe from FormulationID. One-to-one code/recipe mapping verified. Serum % extracted by explicit % FBS regex; the one serum-free recipe without explicit FBS % is retained as missing, not zero; do not infer unrecorded supplements or basal nutrient concentrations.",
  "excluded_fields": "Fixed PRISM covariate set retained. PlateCoating is constant None in all 744; ModelDerivationMaterial and CulturedResistanceDrug are entirely empty. ModelTreatment has one EBV annotation and is outside the fixed set. SerumFreeMedia has 703 False, one True and 40 missing: no new serum-free predictor is added. The one explicit serum-free recipe has no numeric FBS percentage and is median-imputed with an indicator, without inferring zero. Exact full recipe not separately encoded from its one-to-one medium code.",
  "metadata_limit": "These Model.csv fields describe onboarding, not verified CTRP-screen conditions. Associations may reflect lineage, source or other cell-line properties rather than causal culture effects. The release README description and observed medium columns are reversed; preserve and audit raw field values.",
  "preprocessing": "Fit separately inside every inner training fold and on outer training for refit. Median-impute serum % using current training values; standardize genes and serum only. Encode growth with training-observed categories; medium code/basal family need >=5 current-training rows to retain separate categories. Other/unseen categories share reserved OTHER; missing is explicit MISSING. One-hot and missingness indicators are centered but never variance-standardized, avoiding rare-category amplification. Training column means center the joint matrix.",
  "categorical_min_counts": {
    "growth_pattern": 1,
    "medium_code": 5,
    "basal_medium": 5
  },
  "weighting": "Unweighted across all arms; tuning equal-mean five-fold RMSE in original CTRP target units. No outer-test selection of categories, imputation values, scalers or hyperparameters.",
  "solver_stability": "Same candidate grid; new mixed-feature Elastic Net fits use tighter tol=1e-11/max_iter=200000 versus saved baseline tol=1e-9/max_iter=50000. Pure-Lasso inner candidates use native cold starts to match outer refits. Independent augmented-Lasso objectives/KKT are checked where coefficients are nonunique.",
  "controls": "Reuse 120 verified gene-only models, newly fit 120 gene+culture models and 60 culture-only models. Same source targets, RNA values, outer/inner masks and initialization seed triplets. Native unweighted MLP replaces the unit-weight adapter; numerical parity checked independently.",
